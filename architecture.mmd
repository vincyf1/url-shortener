flowchart LR
  subgraph Presentation
    TUI["Textual TUI<br/>URLShortenerApp and Screens"]
    HTTP["Redirect HTTP Server<br/>RedirectServer and RedirectHandler"]
  end

  subgraph Domain_Service
    SVC["Shortener Service<br/>validate_url and create_short_url"]
  end

  subgraph Repository_Boundary
    IFACE["URLRepository interface<br/>URLRecord and AppSetting dataclasses"]
    FACADE["Database facade<br/>resolve_storage_config by DB_BACKEND"]
  end

  subgraph Storage_Adapters
    SQLITE["SQLiteRepository"]
    PG["PostgreSQLRepository"]
    MY["MySQLRepository"]
  end

  TUI --> SVC
  TUI --> FACADE
  HTTP --> FACADE
  SVC --> IFACE
  FACADE --> IFACE

  SQLITE --> IFACE
  PG --> IFACE
  MY --> IFACE

  SQLITE --> SDB[(SQLite urls.db)]
  PG --> PDB[(PostgreSQL)]
  MY --> MDB[(MySQL)]
