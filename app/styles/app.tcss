/* URL Shortener TUI — Modern high-contrast theme */

Screen {
    background: #0b1220;
    color: #f8fafc;
}

Header {
    dock: top;
    background: #111827;
    color: #e2e8f0;
    text-style: bold;
}

Footer {
    dock: bottom;
    background: #0f172a;
    color: #cbd5e1;
}

DataTable {
    height: 1fr;
    margin: 0 1;
    background: #0f172a;
    color: #e2e8f0;
    border: round #334155;
}

DataTable > .datatable--header {
    background: #1e293b;
    color: #67e8f9;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #22d3ee;
    color: #0b1220;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1f2937;
}

ModalScreen {
    background: #020617 82%;
}

Input {
    margin: 0;
    background: #0b1220;
    color: #f8fafc;
    border: round #334155;
}

Input:focus {
    border: tall #22d3ee;
}

Button {
    min-width: 12;
}

Button.-primary {
    background: #06b6d4;
    color: #0b1220;
    text-style: bold;
}

Button.-warning {
    background: #f59e0b;
    color: #0b1220;
}

Button.-error {
    background: #ef4444;
    color: #ffffff;
    text-style: bold;
}

Button.-default {
    background: #334155;
    color: #e2e8f0;
}

Switch {
    margin: 0 1;
}
