/* URL Shortener TUI — adaptive theme (dark/light aware) */

Screen {
    background: $surface;
    color: $text;
}

Header {
    dock: top;
    background: $surface-darken-1;
    color: $text;
    text-style: bold;
}

Footer {
    dock: bottom;
    background: $surface-darken-1;
    color: $text-muted;
}

DataTable {
    height: 1fr;
    margin: 0 1;
    background: $surface;
    color: $text;
    border: round $primary;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $surface-lighten-1;
}

ModalScreen {
    background: $background 82%;
}

Input {
    margin: 0;
    background: $surface;
    color: $text;
    border: round $primary;
}

Input:focus {
    border: tall $accent;
}

Button {
    min-width: 12;
}

Button.-primary {
    background: $accent;
    color: $text;
    text-style: bold;
}

Button.-warning {
    background: $warning;
    color: $text;
}

Button.-error {
    background: $error;
    color: $text;
    text-style: bold;
}

Button.-default {
    background: $panel;
    color: $text;
}

Switch {
    margin: 0 1;
}
